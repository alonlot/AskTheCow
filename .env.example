# Authentication for Claude Code (claude -p): an API key, or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
ANTHROPIC_API_KEY=

# Repository (SSH or HTTPS with a read-only token). Only this branch is used.
ASKTHECOW_REPO_URL=git@github.com:your-org/your-firmware.git
ASKTHECOW_BRANCH=master
ASKTHECOW_PROJECT_NAME=Motor controller firmware
ASKTHECOW_DATA_DIR=data

# Claude Code CLI and models (--model accepts full names or aliases such as opus, sonnet, haiku)
ASKTHECOW_CLAUDE_BIN=claude
ASKTHECOW_MODEL=claude-opus-5-5
ASKTHECOW_ANSWER_EFFORT=high
ASKTHECOW_CALIBRATION_MODEL=claude-opus-5-5
ASKTHECOW_DIGEST_EFFORT=medium
ASKTHECOW_BRIEF_EFFORT=high
ASKTHECOW_FALLBACK_MODEL=

# Agent limits
ASKTHECOW_ANSWER_TIMEOUT_SECONDS=900
ASKTHECOW_ANSWER_MAX_BUDGET_USD=0
ASKTHECOW_MAX_CONCURRENT_AGENTS=3
ASKTHECOW_BRIEF_TIMEOUT_SECONDS=3600
ASKTHECOW_DIGEST_TIMEOUT_SECONDS=900

# Calibration
ASKTHECOW_DIGEST_CHUNK_CHARS=120000
ASKTHECOW_MAX_DIFF_CHARS_PER_COMMIT=8000
ASKTHECOW_DIGEST_CONCURRENCY=4
ASKTHECOW_BRIEF_MAX_CHARS=60000
ASKTHECOW_HISTORY_MAX_CHARS=400000
ASKTHECOW_FULL_REBRIEF_EVERY=25
ASKTHECOW_AUTO_CALIBRATE=true

# Sync with the remote
ASKTHECOW_POLL_INTERVAL_SECONDS=300
ASKTHECOW_FETCH_MIN_INTERVAL_SECONDS=30
ASKTHECOW_WEBHOOK_SECRET=

# Extra channels (for example email), as module:ClassName, comma separated
ASKTHECOW_CHANNELS=

# HTTP
ASKTHECOW_HOST=127.0.0.1
ASKTHECOW_PORT=8000
ASKTHECOW_PASSWORD=
ASKTHECOW_API_TOKEN=
ASKTHECOW_ADMIN_TOKEN=
